  "query": "SELECT a.genesis AS \"genesis!\", l.seqno AS \"seqno!\", l.digest AS \"digest!\"\n             FROM accounts a\n             JOIN account_links l ON l.account = a.account AND l.genesis = a.genesis\n             WHERE a.account = $1 ORDER BY l.seqno DESC LIMIT 1",
