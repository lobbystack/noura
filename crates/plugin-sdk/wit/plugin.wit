// The first version of Noura's plugin interface. Tickets before the first
// release extend this package; once a release ships it, a change needs a new
// version and the host keeps loading plugins built against this one.
package noura:plugin@0.1.0;

// What a capability interface returns when it refuses or fails a call.
interface types {
  // A property whose value doesn't fit its object type's schema.
  record property-error {
    // The property's name.
    property: string,
    // What is wrong, as the workspace format's validation codes say:
    // `wrong_type`, `not_allowed`, `invalid_date` or `invalid_reference`.
    code: string,
  }

  variant error {
    // The plugin's manifest doesn't declare the capability this call needs.
    // Holds the capability's name, such as `workspace-read`. The host ran
    // nothing for the call. A write to an object whose type the plugin
    // didn't register, a note for one, returns this too, naming
    // `object-types`: the capability covers the plugin's own types only.
    capability-not-declared(string),
    // A file or folder name that a WIT string can't hold, such as one that
    // isn't valid UTF-8. Noura never passes a changed copy of a name.
    unsupported-path,
    // The path isn't a workspace-relative path with `/` between its parts:
    // it is empty, absolute, holds `.`, `..` or `\`, or names a folder
    // Noura keeps to itself, such as `.noura`. Holds the path.
    invalid-path(string),
    // Nothing in the workspace has this path or ID. Holds the path or ID.
    not-found(string),
    // The host couldn't finish the call. Holds a message for the plugin's
    // author.
    failed(string),
    // The object's file changed since the plugin read it: it no longer
    // holds the content revision the write carried. Nothing was written.
    // Holds the object's ID.
    revision-conflict(string),
    // More than one file holds this stable ID, as after a copy in another
    // app, so writes by ID stop until only one file does. Holds the ID.
    identity-conflict(string),
    // A property doesn't fit the object type's schema. Nothing was
    // written.
    invalid-property(property-error),
    // Something already has the path the write asked for. Holds the path.
    already-exists(string),
  }
}

// Reads the open workspace. Needs the `workspace-read` capability.
interface workspace {
  use types.{error};

  enum entry-kind {
    file,
    folder,
  }

  // One file or folder in the workspace.
  record entry {
    // The workspace-relative path, with `/` between its parts.
    path: string,
    kind: entry-kind,
    // The stable ID of a file that holds a Noura object. It stays the same
    // when the file moves or is renamed.
    object-id: option<string>,
    // The object's type, such as `note`.
    object-type: option<string>,
    // The revision of the file's content, once Noura has read the file.
    revision: option<string>,
  }

  // A file's bytes and the revision of those bytes.
  record file {
    path: string,
    bytes: list<u8>,
    revision: string,
  }

  // A Noura object, read by its stable ID.
  record object {
    id: string,
    object-type: string,
    // The object's title: its file name without the extension.
    title: string,
    // Where the object's file is now.
    path: string,
    // The Markdown after the frontmatter.
    body: string,
    // The frontmatter's other properties, as a JSON object.
    properties: string,
    revision: string,
  }

  // Every file and folder in the workspace, by path. An item whose name a
  // WIT string can't hold appears as `unsupported-path` in its place.
  list-entries: func() -> result<list<result<entry, error>>, error>;

  // The file at a workspace-relative path.
  read-file: func(path: string) -> result<file, error>;

  // The object with this stable ID, wherever its file is now.
  read-object: func(id: string) -> result<object, error>;
}

// UI as data. WIT has no recursive types, so a view is a flat list of nodes
// whose `children` hold indices into the list. The first node is the root.
//
// Every label must hold more than spaces: Noura reads it to screen readers.
interface ui {
  // A line in a list: a label and an optional quieter detail after it, on
  // the same line. A board's card shows the detail under the label.
  record item {
    label: string,
    detail: option<string>,
  }

  // A list you select items in.
  record item-list {
    // Names the list for screen readers.
    label: string,
    // Whether you can drag its items to new positions. A drop sends
    // `moved`, and the list then shows the items in the order the plugin
    // draws them.
    reorder: bool,
  }

  // A list of items fetched as they scroll into view, so it can hold more
  // rows than a view holds nodes. Noura calls the view's `rows` for them.
  record virtual-list {
    // Names the list for screen readers.
    label: string,
    // How many rows the list holds, at most 1,000,000.
    rows: u32,
  }

  // One row of a virtual list, as `rows` returns it.
  record virtual-row {
    // Unique within the list. Events name the row by this ID.
    id: string,
    item: item,
  }

  enum sort-order {
    ascending,
    descending,
  }

  // A table's column.
  record column {
    // Unique within the table. A header press names the column by it.
    id: string,
    // The header's text.
    title: string,
    // Shows that the table is sorted by this column, and in which order.
    sorted: option<sort-order>,
  }

  record table {
    // Names the table for screen readers.
    label: string,
    columns: list<column>,
  }

  record form {
    // Names the form for screen readers.
    label: string,
    // The label of the button that submits the form.
    submit: string,
  }

  // What an input holds. The case sets the kind of input Noura draws.
  variant value {
    // A single line of text.
    text(string),
    // Several lines of text.
    multiline(string),
    checkbox(bool),
    // The ID of the chosen option, or none.
    choice(option<string>),
    // A date as `YYYY-MM-DD`, the workspace format's date, or none.
    date(option<string>),
    // A date and time in RFC 3339 with an explicit offset, such as
    // `2026-10-21T09:30:00-04:00`, or none.
    date-time(option<string>),
  }

  // One option of a single-choice input.
  record choice {
    // Unique within the input. The input's value names the option by it.
    id: string,
    label: string,
  }

  record input {
    label: string,
    value: value,
    // The options of a choice input. Other inputs have none.
    choices: list<choice>,
  }

  record menu-item {
    label: string,
    // A disabled item shows but can't be chosen.
    enabled: bool,
  }

  variant node-kind {
    // Lays out its children from top to bottom. The label names the panel
    // for screen readers.
    panel(option<string>),
    // A line of plain text.
    text(string),
    // Markdown, drawn by Noura. Images show as their description and never
    // load from the network.
    markdown(string),
    // A button with this label. Presses come back by the node's ID. A
    // button whose child is a menu opens the menu instead.
    button(string),
    // A list you select items in, by click or arrow keys. Its children
    // are its items.
    %list(item-list),
    // An item of a list. Its only child may be a menu, which opens by
    // right-click or from the keyboard.
    item(item),
    // A list whose rows come from the view's `rows`. It holds no children.
    virtual-list(virtual-list),
    // A table. Its children are its rows.
    table(table),
    // A table row: one cell per column, at least one of them with text.
    // Screen readers name the row by its first cell with text. Its only
    // child may be a menu.
    row(list<string>),
    // Lays out its children like a panel, with a submit button after them.
    // Submitting sends the value of every input inside it.
    form(form),
    // A labeled input. Changes come back by the node's ID.
    input(input),
    // A menu with this label, the child of an item, a row, a card or a
    // button. Its children are menu items and separators, at least one
    // item among them.
    menu(string),
    // A menu item. Choosing it sends its node ID.
    menu-item(menu-item),
    // A line between menu items.
    separator,
    // A board, named for screen readers by this label. Its children are
    // its columns, at least one. You drag cards within a column and
    // between the board's columns: a drop sends `moved`, and the board
    // then shows the cards where the plugin draws them, so a move the
    // plugin refuses puts the card back.
    board(string),
    // A column of a board, with this label in its header. Its children
    // are its cards.
    board-column(string),
    // A card in a board column, with its detail under its label. You
    // select a card by click or arrow keys and open it by double-click or
    // Enter, which send `selected` and `activated` naming the board. Its
    // only child may be a menu, which opens by right-click or from the
    // keyboard.
    card(item),
  }

  record node {
    // Unique within the view. Events name the node by this ID.
    id: string,
    kind: node-kind,
    // Indices into the view's node list. Panels and forms hold the nodes
    // they lay out, lists their items, tables their rows, boards their
    // columns, columns their cards, and menus their items; an item, a
    // row, a card or a button may hold one menu.
    children: list<u32>,
  }

  // An item of a list, a row of a table or a card of a board.
  record target {
    // The node ID of the list, virtual list, table or board.
    node: string,
    // The item's, the row's or the card's node ID, or a virtual list
    // row's ID.
    item: string,
  }

  // A card or a list item dragged to a new place. Nothing moves until the
  // plugin draws it there.
  record move {
    // The node ID of the board or the list.
    node: string,
    // The node ID of the card or the item.
    item: string,
    // The node ID of the column the card was dropped in, or the list's
    // own node ID.
    to: string,
    // Where it goes among that column's cards or the list's items,
    // counted from 0 as if it had already left its old place.
    position: u32,
  }

  // A header press in a table.
  record column-press {
    // The table's node ID.
    node: string,
    // The column's ID.
    column: string,
  }

  // An input's value.
  record field {
    // The input's node ID.
    node: string,
    value: value,
  }

  record submission {
    // The form's node ID.
    node: string,
    // Every input inside the form, in view order.
    fields: list<field>,
  }

  // Something you did in a view.
  variant event {
    // The button with this node ID was pressed.
    pressed(string),
    // An item, a row or a card was selected, by click or arrow keys.
    selected(target),
    // An item, a row or a card was opened, by double-click or Enter.
    activated(target),
    // A table's column header was pressed, so the plugin can sort.
    sorted(column-press),
    // An input's value changed.
    changed(field),
    // A form was submitted.
    submitted(submission),
    // The menu item with this node ID was chosen.
    chosen(string),
    // A card or a list item was dropped in a new place.
    moved(move),
  }
}

// Pages in Noura's rail, drawn from the plugin's nodes. Noura calls these
// only when the manifest declares the `views` capability.
interface view {
  use ui.{node, event, virtual-row};

  record page {
    // Unique within the plugin.
    id: string,
    // The name the rail and the page's tab show.
    title: string,
  }

  // The pages the plugin adds to the rail.
  pages: func() -> list<page>;

  // The nodes of a page's view.
  render: func(page: string) -> list<node>;

  // Rows `start` up to `start + count` of the virtual list with node ID
  // `node` in a page's view, as they scroll into view. Return fewer when
  // the list ends sooner.
  rows: func(page: string, node: string, start: u32, count: u32) -> list<virtual-row>;

  // Something happened in a page's view. Noura renders the page again
  // afterwards.
  handle-event: func(page: string, event: event);
}

// Objects of the types the plugin registered: Markdown files in the
// workspace with a stable ID, properties its schema checks, and a body.
// Needs the `object-types` capability. A call about any other type, a
// note for one, returns `capability-not-declared("object-types")` and
// reaches no file. Writes carry the content revision the plugin read,
// and return once the file is durably on disk.
interface objects {
  use types.{error, property-error};

  // An object as its file holds it now.
  record object {
    // The stable ID: the type, an underscore and a ULID. It stays the
    // same when the file moves or is renamed.
    id: string,
    object-type: string,
    // The object's title: its file name without the extension.
    title: string,
    // Where the object's file is now, relative to the workspace.
    path: string,
    // The Markdown after the frontmatter.
    body: string,
    // The frontmatter's other properties, as a JSON object.
    properties: string,
    // The revision of the file's content. Writes carry it.
    revision: string,
    // The first property, in the schema's order, that doesn't fit the
    // type's schema. Noura leaves such a file as it is.
    problem: option<property-error>,
  }

  // A new object.
  record new-object {
    // One of the plugin's own types.
    object-type: string,
    // The title, which names the file when `path` is none. With a path,
    // the path's file name is the title and this one may be empty.
    title: string,
    // Where to write the file, relative to the workspace, ending in `.md`.
    // Without it the file goes in a folder named after the type, as
    // `recipes/<title>.md` for `recipe`, with a number added when the
    // name is taken.
    path: option<string>,
    // The Markdown after the frontmatter.
    body: string,
    // The properties, as a JSON object. The schema adds the defaults of
    // the ones left out.
    properties: string,
  }

  // What an update changes. The rest of the file keeps its bytes.
  record changes {
    // The new body, or none to keep it.
    body: option<string>,
    // Properties to set, as a JSON object.
    properties: string,
    // Properties to remove.
    remove: list<string>,
  }

  // Create an object. Fails with `already-exists` when a file has the
  // path.
  create: func(object: new-object) -> result<object, error>;

  // The object with this stable ID, read from its file.
  get: func(id: string) -> result<object, error>;

  // Every object of one of the plugin's types, read from their files. An
  // object whose properties don't fit the schema comes with its `problem`.
  %list: func(object-type: string) -> result<list<object>, error>;

  // Change an object's body or properties. Fails with `revision-conflict`
  // when the file no longer holds `expected-revision`.
  update: func(id: string, expected-revision: string, changes: changes) -> result<object, error>;

  // Move an object's file to `path`, which renames it when only the file
  // name changes. The object keeps its ID.
  move-to: func(id: string, expected-revision: string, path: string) -> result<object, error>;

  // Move an object's file to the system trash, or to the workspace's
  // trash folder when the system has none.
  delete: func(id: string, expected-revision: string) -> result<_, error>;
}

// The object types the plugin adds, and the properties panel Noura shows
// beside the body of each of their objects in the note editor. Noura
// calls these only when the manifest declares the `object-types`
// capability.
interface object-types {
  use ui.{node, event};

  record object-type {
    // A lowercase letter followed by lowercase letters or hyphens. Noura
    // keeps its own types, such as `note`, and a type another running
    // plugin registered stays that plugin's.
    name: string,
    // The type's properties in the workspace format's schema
    // declaration, as JSON.
    schema: string,
  }

  // The types the plugin registers when it starts.
  types: func() -> list<object-type>;

  // The nodes of the properties panel for the object with this ID. A
  // panel can't hold a virtual list, since nothing fetches its rows:
  // Noura shows why in the panel's place.
  render-panel: func(object: string) -> list<node>;

  // Something happened in an object's properties panel. Noura draws the
  // panel again afterwards.
  handle-panel-event: func(object: string, event: event);
}

world plugin {
  import workspace;
  import objects;
  export view;
  export object-types;
}
