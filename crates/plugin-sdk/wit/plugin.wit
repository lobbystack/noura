// The first version of Noura's plugin interface. Tickets before the first
// release extend this package; once a release ships it, a change needs a new
// version and the host keeps loading plugins built against this one.
package noura:plugin@0.1.0;

// What a capability interface returns when it refuses or fails a call.
interface types {
  // A property whose value doesn't fit its object type's schema.
  record property-error {
    // The property's name.
    property: string,
    // What is wrong, as the workspace format's validation codes say:
    // `wrong_type`, `not_allowed`, `invalid_date` or `invalid_reference`.
    code: string,
  }

  variant error {
    // The plugin's manifest doesn't declare the capability this call needs.
    // Holds the capability's name, such as `workspace-read`. The host ran
    // nothing for the call. A write to an object whose type the plugin
    // didn't register, a note for one, returns this too, naming
    // `object-types`: the capability covers the plugin's own types only.
    capability-not-declared(string),
    // A file or folder name that a WIT string can't hold, such as one that
    // isn't valid UTF-8. Noura never passes a changed copy of a name.
    unsupported-path,
    // The path isn't a workspace-relative path with `/` between its parts:
    // it is empty, absolute, holds `.`, `..` or `\`, or names a folder
    // Noura keeps to itself, such as `.noura`. Holds the path.
    invalid-path(string),
    // Nothing in the workspace has this path or ID. Holds the path or ID.
    not-found(string),
    // The host couldn't finish the call. Holds a message for the plugin's
    // author.
    failed(string),
    // The object's file changed since the plugin read it: it no longer
    // holds the content revision the write carried. Nothing was written.
    // Holds the object's ID.
    revision-conflict(string),
    // More than one file holds this stable ID, as after a copy in another
    // app, so writes by ID stop until only one file does. Holds the ID.
    identity-conflict(string),
    // A property doesn't fit the object type's schema. Nothing was
    // written.
    invalid-property(property-error),
    // Something already has the path the write asked for. Holds the path.
    already-exists(string),
  }
}

// Reads the open workspace. Needs the `workspace-read` capability.
interface workspace {
  use types.{error};

  enum entry-kind {
    file,
    folder,
  }

  // One file or folder in the workspace.
  record entry {
    // The workspace-relative path, with `/` between its parts.
    path: string,
    kind: entry-kind,
    // The stable ID of a file that holds a Noura object. It stays the same
    // when the file moves or is renamed.
    object-id: option<string>,
    // The object's type, such as `note`.
    object-type: option<string>,
    // The revision of the file's content, once Noura has read the file.
    revision: option<string>,
  }

  // A file's bytes and the revision of those bytes.
  record file {
    path: string,
    bytes: list<u8>,
    revision: string,
  }

  // A Noura object, read by its stable ID.
  record object {
    id: string,
    object-type: string,
    // The object's title: its file name without the extension.
    title: string,
    // Where the object's file is now.
    path: string,
    // The Markdown after the frontmatter.
    body: string,
    // The frontmatter's other properties, as a JSON object.
    properties: string,
    revision: string,
  }

  // Every file and folder in the workspace, by path. An item whose name a
  // WIT string can't hold appears as `unsupported-path` in its place.
  list-entries: func() -> result<list<result<entry, error>>, error>;

  // The file at a workspace-relative path.
  read-file: func(path: string) -> result<file, error>;

  // The object with this stable ID, wherever its file is now.
  read-object: func(id: string) -> result<object, error>;
}

// UI as data. WIT has no recursive types, so a view is a flat list of nodes
// whose `children` hold indices into the list. The first node is the root.
interface ui {
  variant node-kind {
    // Lays out its children from top to bottom. The label names the panel
    // for screen readers.
    panel(option<string>),
    // A line of plain text.
    text(string),
    // Markdown, drawn by Noura. Images show as their description and never
    // load from the network.
    markdown(string),
    // A button with this label. Presses come back by the node's ID.
    button(string),
  }

  record node {
    // Unique within the view. Events name the node by this ID.
    id: string,
    kind: node-kind,
    // Indices into the view's node list. Only panels hold children.
    children: list<u32>,
  }

  // Something you did in a view.
  variant event {
    // The button with this node ID was pressed.
    pressed(string),
  }
}

// Pages in Noura's rail, drawn from the plugin's nodes. Noura calls these
// only when the manifest declares the `views` capability.
interface view {
  use ui.{node, event};

  record page {
    // Unique within the plugin.
    id: string,
    // The name the rail and the page's tab show.
    title: string,
  }

  // The pages the plugin adds to the rail.
  pages: func() -> list<page>;

  // The nodes of a page's view.
  render: func(page: string) -> list<node>;

  // Something happened in a page's view. Noura renders the page again
  // afterwards.
  handle-event: func(page: string, event: event);
}

// Objects of the types the plugin registered: Markdown files in the
// workspace with a stable ID, properties its schema checks, and a body.
// Needs the `object-types` capability. A call about any other type, a
// note for one, returns `capability-not-declared("object-types")` and
// reaches no file. Writes carry the content revision the plugin read,
// and return once the file is durably on disk.
interface objects {
  use types.{error, property-error};

  // An object as its file holds it now.
  record object {
    // The stable ID: the type, an underscore and a ULID. It stays the
    // same when the file moves or is renamed.
    id: string,
    object-type: string,
    // The object's title: its file name without the extension.
    title: string,
    // Where the object's file is now, relative to the workspace.
    path: string,
    // The Markdown after the frontmatter.
    body: string,
    // The frontmatter's other properties, as a JSON object.
    properties: string,
    // The revision of the file's content. Writes carry it.
    revision: string,
    // The first property, in the schema's order, that doesn't fit the
    // type's schema. Noura leaves such a file as it is.
    problem: option<property-error>,
  }

  // A new object.
  record new-object {
    // One of the plugin's own types.
    object-type: string,
    // The title, which names the file.
    title: string,
    // Where to write the file, relative to the workspace, ending in `.md`.
    // Without it the file goes in a folder named after the type, as
    // `recipes/<title>.md` for `recipe`, with a number added when the
    // name is taken.
    path: option<string>,
    // The Markdown after the frontmatter.
    body: string,
    // The properties, as a JSON object. The schema adds the defaults of
    // the ones left out.
    properties: string,
  }

  // What an update changes. The rest of the file keeps its bytes.
  record changes {
    // The new body, or none to keep it.
    body: option<string>,
    // Properties to set, as a JSON object.
    properties: string,
    // Properties to remove.
    remove: list<string>,
  }

  // Create an object. Fails with `already-exists` when a file has the
  // path.
  create: func(object: new-object) -> result<object, error>;

  // The object with this stable ID, read from its file.
  get: func(id: string) -> result<object, error>;

  // Every object of one of the plugin's types, read from their files. An
  // object whose properties don't fit the schema comes with its `problem`.
  %list: func(object-type: string) -> result<list<object>, error>;

  // Change an object's body or properties. Fails with `revision-conflict`
  // when the file no longer holds `expected-revision`.
  update: func(id: string, expected-revision: string, changes: changes) -> result<object, error>;

  // Move an object's file to `path`, which renames it when only the file
  // name changes. The object keeps its ID.
  move-to: func(id: string, expected-revision: string, path: string) -> result<object, error>;

  // Move an object's file to the system trash, or to the workspace's
  // trash folder when the system has none.
  delete: func(id: string, expected-revision: string) -> result<_, error>;
}

// The object types the plugin adds, and the properties panel Noura shows
// beside the body of each of their objects in the note editor. Noura
// calls these only when the manifest declares the `object-types`
// capability.
interface object-types {
  use ui.{node, event};

  record object-type {
    // A lowercase letter followed by lowercase letters or hyphens. Noura
    // keeps its own types, such as `note`, and a type another running
    // plugin registered stays that plugin's.
    name: string,
    // The type's properties in the workspace format's schema
    // declaration, as JSON.
    schema: string,
  }

  // The types the plugin registers when it starts.
  types: func() -> list<object-type>;

  // The nodes of the properties panel for the object with this ID.
  render-panel: func(object: string) -> list<node>;

  // Something happened in an object's properties panel. Noura draws the
  // panel again afterwards.
  handle-panel-event: func(object: string, event: event);
}

world plugin {
  import workspace;
  import objects;
  export view;
  export object-types;
}
