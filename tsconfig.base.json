{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"resolveJsonModule": true,
		"verbatimModuleSyntax": true,
		"declaration": true,
		"skipLibCheck": true,
		"types": ["bun"]
	}
}
