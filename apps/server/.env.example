DATABASE_URL=postgres://noura:noura@localhost:5432/noura
PORT=1900
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:1900
# Header your reverse proxy overwrites with the client address for rate limiting.
# Defaults to x-forwarded-for; Railway sets x-real-ip.
# TRUSTED_IP_HEADER=x-real-ip
AUTH_SECRET=replace-with-at-least-32-random-characters
# Account email delivery: set exactly one of SMTP_URL or RESEND_API_KEY.
SMTP_URL=smtp://localhost:1025
# RESEND_API_KEY=
MAIL_FROM=Noura <noura@localhost>
ALLOWED_EMAILS=
# Ciphertext-only resumable upload storage. Persist this directory along with PostgreSQL.
BLOB_ROOT=./data/blobs
# Optional completed-blob S3 storage; unfinished uploads still require persistent BLOB_ROOT.
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
