{
	"name": "@noura/app",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun run wasm:build && vite",
		"wasm:build": "bun run --filter @noura/workspace-format-wasm wasm:build",
		"build": "bun run wasm:build && vite build",
		"build:hosted": "bun run wasm:build && NOURA_HOSTED_BUILD=1 vite build",
		"check": "bun run wasm:build && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check src",
		"tauri": "tauri"
	},
	"dependencies": {
		"@better-auth/passkey": "1.7.2",
		"better-auth": "1.7.2",
		"dompurify": "3.4.14",
		"marked": "18.0.11",
		"@noura/ai": "workspace:*",
		"@noura/browser-sync": "workspace:*",
		"@noura/browser-sync-engine": "workspace:*",
		"@noura/browser-workspace": "workspace:*",
		"@noura/browser-storage": "workspace:*",
		"@noura/workspace-format-wasm": "workspace:*",
		"@noura/editor": "workspace:*",
		"@noura/plugin-calendar": "workspace:*",
		"@noura/plugin-sdk": "workspace:*",
		"@noura/shared": "workspace:*",
		"@noura/workspace": "workspace:*",
		"@tauri-apps/api": "^2",
		"pdfjs-dist": "6.3.289",
		"svelte": "^5"
	},
	"devDependencies": {
		"@types/jsdom": "30.0.0",
		"jsdom": "30.0.1",
		"@fontsource-variable/public-sans": "^5.3.0",
		"@internationalized/date": "^3.12.0",
		"@sveltejs/adapter-static": "latest",
		"@sveltejs/kit": "latest",
		"@sveltejs/vite-plugin-svelte": "latest",
		"@tailwindcss/vite": "latest",
		"@tauri-apps/cli": "^2",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"formsnap": "^2.0.1",
		"mode-watcher": "^1.1.0",
		"phosphor-svelte": "^3.1.0",
		"shadcn-svelte": "^1.5.1",
		"svelte-check": "latest",
		"svelte-sonner": "^1.1.0",
		"sveltekit-superforms": "^2.30.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "latest",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "latest"
	}
}
