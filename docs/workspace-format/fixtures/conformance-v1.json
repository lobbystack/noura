	"object_body": [
		{
			"name": "trailing space typed at the end stays",
			"body": "Typing ",
			"expected_body": "Typing ",
			"file_ends_with": "---\nTyping "
		},
		{
			"name": "two trailing spaces keep a Markdown line break",
			"body": "Line  \nnext",
			"expected_body": "Line  \nnext",
			"file_ends_with": "---\nLine  \nnext"
		},
		{
			"name": "trailing line breaks stay as they are",
			"body": "Text\n\n",
			"expected_body": "Text\n\n",
			"file_ends_with": "---\nText\n\n"
		},
		{
			"name": "a body without a final line break gets none",
			"body": "Text",
			"expected_body": "Text",
			"file_ends_with": "---\nText"
		},
		{
			"name": "CRLF line breaks are written as they are and read as LF",
			"body": "Text\r\n",
			"expected_body": "Text\n",
			"file_ends_with": "---\nText\r\n"
		},
		{
			"name": "a body of only whitespace stays",
			"body": "  \n",
			"expected_body": "  \n",
			"file_ends_with": "---\n  \n"
		},
		{
			"name": "a heading in the body is ordinary text",
			"body": "# Plan\n\nSteps\n",
			"expected_body": "# Plan\n\nSteps\n",
			"file_ends_with": "---\n# Plan\n\nSteps\n"
		},
		{
			"name": "an empty body ends the file with the frontmatter",
			"body": "",
			"expected_body": "",
			"file_ends_with": ":00Z\n---\n"
		}
	],
	"titles": [
		{
			"name": "a managed note is named by its file, not its heading",
			"path": "notes/Team sync.md",
			"markdown": "---\nid: note_01j00000000000000000000000\ntype: note\n---\n# Agenda\n",
			"title": "Team sync",
			"body": "# Agenda\n"
		},
		{
			"name": "a Markdown file without an ID is named by its file too",
			"path": "Plain.md",
			"markdown": "# A heading\nText",
			"title": "Plain",
			"body": "# A heading\nText"
		},
		{
			"name": "only the last extension leaves the name",
			"path": "notes/v1.2 notes.md",
			"markdown": "---\nid: note_01j00000000000000000000000\ntype: note\n---\n",
			"title": "v1.2 notes",
			"body": ""
		},
		{
			"name": "a project folder note is named like its folder",
			"path": "projects/Launch/Launch.md",
			"markdown": "---\nid: project_01j00000000000000000000000\ntype: project\nstatus: active\n---\nShip it.\n",
			"title": "Launch",
			"body": "Ship it.\n"
		},
		{
			"name": "a byte-order mark before the frontmatter leaves the file managed",
			"path": "Marked.md",
			"markdown": "\ufeff---\r\nid: note_01j00000000000000000000000\r\ntype: note\r\n---\r\nBody\r\n",
			"title": "Marked",
			"body": "Body\n"
		}
	],
