{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Noura",
	"version": "0.1.0",
	"identifier": "org.noura.desktop",
	"build": {
		"beforeDevCommand": "bun --cwd apps/app dev",
		"devUrl": "http://localhost:5173",
		"beforeBuildCommand": "bun --cwd apps/app build",
		"frontendDist": "../apps/app/build"
	},
	"app": {
		"windows": [
			{
				"title": "Noura",
				"width": 1024,
				"height": 720,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"trafficLightPosition": { "x": 16, "y": 16 }
			}
		],
		"security": {
			"csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; img-src 'self' data: blob:; font-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'"
		}
	},
	"bundle": { "active": true, "targets": "all" }
}
